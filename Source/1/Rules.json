{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[a-z0-9]{8,32}$/)",
        ".write": "$room.matches(/^[a-z0-9]{8,32}$/)",
        "v": {
          "$slot": { ".validate": "newData.hasChildren(['s', 'k', 't', 'd']) && newData.child('d').isString() && newData.child('d').val().length < 2000000" }
        },
        "hb": { ".validate": "newData.hasChildren(['sid', 'key', 't'])" },
        "in": {
          "$slot": { ".validate": "newData.hasChildren(['sid', 's', 'e'])" }
        },
        "info": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
